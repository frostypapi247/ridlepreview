{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --config artifacts/riddle-security/vite.config.ts --host 0.0.0.0",
    "build": "vite build --config artifacts/riddle-security/vite.config.ts",
    "workspace:build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.545.0",
    "prettier": "^3.9.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.3.2",
    "wouter": "^3.3.5"
  }
}
